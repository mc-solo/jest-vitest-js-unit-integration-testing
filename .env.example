# Copy to .env and adjust. Never commit a real .env (it is gitignored).
# No .env loader is installed: export these in your shell, or prefix a
# command, e.g. API_BASE_URL=http://localhost:3000 npm test.

# Environment preset: default | local | ci (see config/environments.ts)
TEST_ENV=default

# Base URL of the API under test. Overrides the TEST_ENV preset.
API_BASE_URL=https://jsonplaceholder.typicode.com

# Request timeout in ms (used as the live-test timeout).
API_TIMEOUT_MS=8000

# Timeout in ms for the one live-network test in tests/api-client.test.ts.
LIVE_TEST_TIMEOUT_MS=8000
